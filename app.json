{
  "expo": {
    "name": "Smart Finances",
    "slug": "smart-finances",
    "owner": "va-p",
    "version": "2.30.1",
    "scheme": "com.vap.smartfinances",
    "jsEngine": "hermes",
    "orientation": "portrait",
    "backgroundColor": "#E6E9F4",
    "primaryColor": "#FF5200",
    "platforms": ["ios", "android"],
    "android": {
      "package": "com.vap.smartfinances",
      "versionCode": 107,
      "permissions": [
        "VIBRATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_FINGERPRINT",
        "USE_BIOMETRIC"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "https",
              "host": "smartfinances.com.br",
              "pathPrefix": "/oauth-native-callback"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    },
    "ios": {
      "bundleIdentifier": "com.vap.smartfinances",
      "buildNumber": "1",
      "permissions": [
        "VIBRATE",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "USE_FINGERPRINT",
        "USE_BIOMETRIC"
      ],
      "supportsTablet": true,
      "backgroundColor": "#E6E9F4",
      "icon": "src/assets/icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "a17a404b-a307-4781-a880-7b717ea58c58"
      }
    },
    "updates": {
      "enabled": false
    },
    "plugins": [
      [
        "@revopush/expo-code-push-plugin",
        {
          "ios": {
            "CodePushDeploymentKey": "2S47-wY5h-5-wY25R_KLdc1NWkNqE12osk8wMe",
            "CodePushServerUrl": "https://api.revopush.org"
          },
          "android": {
            "CodePushDeploymentKey": "2S47-wY5h-5-wY25R_KLdc1NWkNqE12osk8wMe",
            "CodePushServerUrl": "https://api.revopush.org"
          }
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": true,
          "supportsPictureInPicture": true
        }
      ],
      "expo-font",
      "expo-router",
      "expo-web-browser",
      "expo-secure-store",
      ["expo-splash-screen"],
      "@react-native-firebase/app",
      "@react-native-firebase/perf",
      "@react-native-firebase/crashlytics"
    ]
  }
}
